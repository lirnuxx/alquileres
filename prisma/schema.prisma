datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  AGENT
  SEARCHER
}

enum OperationType {
  RENT
  SALE
}

enum PropertyType {
  APARTMENT
  HOUSE
  PH
  LAND
  OFFICE
  COMMERCIAL_LOCAL
}

enum PropertyStatus {
  ACTIVE
  PAUSED
  RENTED
  SOLD
}

enum PlanTier {
  FREE
  BASIC
  PRO
}

model Tenant {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  customDomain String?    @unique
  logoUrl      String?
  primaryColor String?
  planTier     PlanTier   @default(FREE)
  createdAt    DateTime   @default(now())
  properties   Property[]
  leads        Lead[]
}

model Property {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String
  operationType  OperationType
  propertyType   PropertyType
  status         PropertyStatus  @default(ACTIVE)
  price          Float
  currency       String          @default("ARS")
  coveredArea    Float?
  totalArea      Float?
  rooms          Int?
  bedrooms       Int?
  bathrooms      Int?
  ageYears       Int?
  expensasAmount Float?
  address        String
  neighborhood   String?
  city           String
  lat            Float
  lng            Float
  amenities      String          @default("[]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  images         PropertyImage[]
  leads          Lead[]

  @@index([tenantId])
  @@index([city, propertyType, operationType])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
  isCover    Boolean  @default(false)
}

model Lead {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  message    String?
  createdAt  DateTime @default(now())
}
